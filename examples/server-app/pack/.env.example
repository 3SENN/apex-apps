# Copy this file to .env (in this pack/ folder) while you develop.
#
# Atelier reads .env and .env.local from a folder loaded with "Load a folder...",
# and only the names the manifest declares in env and secrets. Neither file is
# ever packed, and .gitignore keeps them out of git.

# Points the app at server.mjs instead of the real server.
SERVER_URL=http://127.0.0.1:8787

# Uncomment to fill the NOTES_TOKEN secret from here instead of typing it on
# the pack's page. Atelier sends it only to the secret's hosts
# (notes.contoso.example), never to 127.0.0.1, so server.mjs doesn't need it.
# NOTES_TOKEN=paste-a-test-token-here
